# Local passwords for docker compose. Copy this file to .env (which is gitignored)
# and fill in your own values. Never commit .env.
#
# SQL Server rules: at least 8 characters, with upper case, lower case and digits.
# Use only letters and digits: the DB passwords are put inside a URL
# (mssql://user:password@host/db), where symbols like @ / : would break it.

MSSQL_SA_PASSWORD=
DIVES_DB_PASSWORD=
SITES_DB_PASSWORD=

# Signs the dives login cookie. Any long random string.
SECRET_KEY=
